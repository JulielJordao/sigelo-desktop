{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "http:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://localhost:3000/*" },
        { "url": "https://sigelo-b0b28f6a8eb7.herokuapp.com/*" },
        { "url": "https://*.sigelo.cloud/*" }
      ]
    }
  ]
}