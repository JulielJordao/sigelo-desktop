{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "*"
  ],
  "permissions": [
    "core:default",
    "fs:default",
    "core:window:allow-minimize",
    "core:window:allow-maximize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-set-title",
    "core:window:allow-start-dragging",
    "process:allow-exit",
    "process:default",
    "shell:default",
    "opener:default",
    "http:default",
    "fs:allow-appdata-read-recursive",
    "fs:allow-appdata-write-recursive",
    "fs:allow-remove",
    "fs:allow-copy-file",
    "fs:allow-stat",
    {
      "identifier": "shell:allow-open",
      "allow": [
        {
          "name": "open",
          "cmd": "",
          "args": true
        }
      ]
    },
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "http://localhost:3000/*"
        },
        {
          "url": "https://*.herokuapp.com/*"
        },
        {
          "url": "https://*.sigelo.cloud/*"
        }
      ]
    },
    "dialog:default",
    "os:default",
    {
      "identifier": "core:event:allow-emit",
      "allow": [
        {
          "event": "sync-pdf-scroll"
        },
        {
          "event": "update-projection"
        },
        {
          "event": "set-fixed-media"
        },
        {
          "event": "project-media"
        },
        {
          "event": "clear-projection"
        },
        {
          "event": "media-control"
        },
        {
          "event": "open-bible"
        },
        {
          "event": "sync-notice-playback"
        },
        {
          "event": "project_media_after_timer"
        },
        {
          "event": "sync_timer_playback"
        },
        {
          "event": "save_timer_settings"
        }
      ]
    },
    {
      "identifier": "core:event:allow-listen",
      "allow": [
        {
          "event": "sync-pdf-scroll"
        },
        {
          "event": "update-projection"
        },
        {
          "event": "set-fixed-media"
        },
        {
          "event": "project-media"
        },
        {
          "event": "clear-projection"
        },
        {
          "event": "media-control"
        },
        {
          "event": "open-bible"
        }, 
        {
          "event": "sync-notice-playback"
        },
        {
          "event": "update-notice-settings"
        },
        {
          "event": "save-notice-settings"
        },
        {
          "event": "project_media_after_timer"
        },
        {
          "event": "sync_timer_playback"
        },
        {
          "event": "save_timer_settings"
        }
      ]
    },
    "fs:allow-exists",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$APPLOCALDATA/**" },
        { "path": "$APPCACHEDIR/**" },
        
        { "path": "$DOWNLOAD/**" },
        { "path": "$DESKTOP/**" },
        { "path": "$DOCUMENT/**" },
        { "path": "$PICTURE/**" },
        { "path": "$VIDEO/**" }
      ]
    },
    "store:default"
  ]
}