{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sigelo - Projeção",
  "version": "0.8.1",
  "identifier": "com.julieljordao.Sigelo",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Sigelo - Editor",
        "url": "/",
        "width": 1600,
        "height": 1000,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "transparent": true,
        "hiddenTitle": true,
        "dragDropEnabled": true
      },
      {
        "label": "projection",
        "title": "Sigelo - Projeção",
        "url": "/projection", 
        "visible": false, 
        "fullscreen": false,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**", 
          "$APPLOCALDATA/**",
          "$APPCACHEDIR/**"]
      },
       "csp": "default-src 'self'; media-src 'self' asset: http://asset.localhost https://asset.localhost blob: data:; img-src 'self' asset: http://asset.localhost https://asset.localhost data:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
