{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sigelo - Projeção",
  "version": "0.5.7",
  "identifier": "com.julieljordao.Sigelo",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Sigelo - Editor",
        "url": "/",
        "width": 1200,
        "height": 800,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      },
      {
        "label": "projection",
        "title": "Sigelo - Projeção",
        "url": "/projection", 
        "visible": false, 
        "fullscreen": false,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
